t.test(MLQ~Condition, data=df_active)
cohen_d_result <- cohen.d(df_active$MLQ[df_active$Condition == 0], df_active$MLQ[df_active$Condition == 1], na.rm = TRUE)
print(cohen_d_result)
df$stimulus_type = ifelse(df$Condition %in% c(0, 1), "Stimulus", "No-Stimulus")
t.test(MLQ~stimulus_type, data=df)
cohen_d_result <- cohen.d(df$MLQ[df$Condition == 0], df$MLQ[df$Condition == 1], na.rm = TRUE)
