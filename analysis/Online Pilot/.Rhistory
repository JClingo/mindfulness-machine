df_minus_nausea = df %>% filter(ParticipantID != 145317216,
ParticipantID != 150787919,
ParticipantID != 104528162,
ParticipantID != 121475818,
ParticipantID != 119803467,
ParticipantID != 150693715,
ParticipantID != 136011243,
ParticipantID != 151831974,
ParticipantID != 192762097
)
df_active = df_minus_nausea %>% filter(Condition < 2)
t.test(MLQ~Condition, data=df_active)
df_minus_nausea$stimulus_type = ifelse(df_minus_nausea$Condition %in% c(0, 1), "Stimulus", "No-Stimulus")
t.test(MLQ~stimulus_type, data=df_minus_nausea)
cohen_d_result <- cohen.d(df_minus_nausea$MLQ[df_minus_nausea$Condition == 0], df_minus_nausea$MLQ[df_minus_nausea$Condition == 1], na.rm = TRUE)
print(cohen_d_result)
