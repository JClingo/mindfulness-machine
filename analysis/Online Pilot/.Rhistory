df <- data.frame(
condition = rep(c("A", "B", "C"), each = 10),
score = c(rnorm(10, mean = 5), rnorm(10, mean = 6), rnorm(10, mean = 7))
)
# Combine conditions A and B into a new group 'AB'
df$group <- ifelse(df$condition %in% c("A", "B"), "AB", "C")
# Perform t-test between group AB and group C
t_test_result <- t.test(score ~ group, data = df)
# View results
print(t_test_result)
# Calculate Cohen's d
library(effsize)
cohen_d_result <- cohen.d(df$score[df$group == "AB"], df$score[df$group == "C"])
# View Cohen's d
print(cohen_d_result)
